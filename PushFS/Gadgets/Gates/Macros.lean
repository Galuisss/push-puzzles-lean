module

public import PushFS.Gadgets.Gates.Slots

/-!
# All 28 full-tile gate transitions

Each literal direction certificate starts and ends at the common hub and
propagates the changed phase through every box in the long-wall tile. The
checked terminal equality includes the protected turns, every buffer and every
flip box, with exact player walks between individual pushes.

## Main results

* `canonical_transition`: every legal one-port change has an actual single-box macro.
* `canonical_transition_placed`: the macro under an actual rectangle placement.
-/

@[expose] public section

namespace PushPuzzle.PushFS.Gadgets.Gates


/-- A concrete complete direction certificate between two canonical phases. -/
structure Case where
  /-- Initial flags. -/
  before : Signals
  /-- Final flags. -/
  after : Signals
  /-- All individual walking and pushing directions. -/
  directions : List Direction

-- The finite certificates replay at most 108 boxes and fewer than 1000 directions.
-- Increased recursion/heartbeat budgets let the kernel reduce those explicit lists.
set_option maxRecDepth 65536
set_option maxHeartbeats 0

def Case.FullChecked (kind : Bool) (c : Case) : Prop :=
  Execution.valid (wallTest kind) (canonical kind c.before) = true ∧
  Execution.check (wallTest kind) (canonical kind c.before)
    (canonical kind c.after) c.directions = true

instance (kind : Bool) (c : Case) : Decidable (c.FullChecked kind) := by
  unfold Case.FullChecked; infer_instance

