module

public import PushFS.Reduction.GeometryChecks

/-! Concrete integer curves joining the fixed W/N/E core to each cyclic outer triple. -/

@[expose] public section

namespace PushPuzzle.PushFS.Reduction.PortAnnulus


/-- The outer triple, cyclic rotation and physical W/N/E port index. -/
abbrev Key := Fin 3 × Fin 3 × Fin 3

