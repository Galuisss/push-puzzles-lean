/-- The actual corner sequence for one of the 27 fixed port curves. -/
def vertices (q : Key) : List (ℕ × ℕ) :=
  (((cornerTable.getD q.1.val []).getD q.2.1.val []).getD q.2.2.val [])

/-- The complete ordered finite segment program of one port curve. -/
def curve (q : Key) : List Segment :=
  (vertices q).zipWith Segment.mk (vertices q).tail

end PushPuzzle.PushFS.Reduction.PortAnnulus
